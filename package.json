{
  "name": "@kyrobit/kyro-datatable",
  "version": "0.1.0",
  "description": "Headless data-table state (pagination, sorting, grouping, filters) with a default MUI rendering layer. State is fully decoupled from UI — bring your own markup, or use the built-in one.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "default": "./dist/state/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyroBit/kyro-datatable.git"
  },
  "keywords": [
    "data-table",
    "table",
    "grid",
    "grouping",
    "pagination",
    "react",
    "mui",
    "headless"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/"
  },
  "peerDependencies": {
    "@mui/material": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.0.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "bun-types": "latest",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.7.0"
  }
}
