{
  "name": "@kyrobit/datatable",
  "version": "0.2.13",
  "description": "Headless data-table state (pagination, sorting, search, server-side grouping) fully decoupled from rendering. Bring your own UI, or use the built-in MUI renderer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "kyro-datatable": "./bin/cli.js"
  },
  "files": [
    "dist",
    "src/renderers",
    "registry",
    "bin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mui": {
      "types": "./dist/renderers/mui/index.d.ts",
      "default": "./dist/renderers/mui/index.js"
    },
    "./kyroui": {
      "types": "./dist/renderers/kyroui/index.d.ts",
      "default": "./dist/renderers/kyroui/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyroBit/kyrotable.git"
  },
  "keywords": [
    "data-table",
    "table",
    "grid",
    "grouping",
    "pagination",
    "react",
    "mui",
    "headless"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json --emitDeclarationOnly && babel src --out-dir dist --extensions .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate tests/",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "@mui/material": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@dnd-kit/core": "*",
    "@dnd-kit/sortable": "*",
    "@dnd-kit/utilities": "*",
    "@dnd-kit/modifiers": "*",
    "@kyrobit/kyroui": ">=0.2.6"
  },
  "peerDependenciesMeta": {
    "@mui/material": {
      "optional": true
    },
    "@kyrobit/kyroui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/cli": "^7",
    "@babel/core": "^7",
    "@babel/preset-react": "^7",
    "@babel/preset-typescript": "^7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@happy-dom/global-registrator": "21.0.4",
    "@kyrobit/kyroui": "0.2.6",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.0.1",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "latest",
    "playwright": "1.62.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.24"
  }
}
